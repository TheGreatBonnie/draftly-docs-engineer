{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true,
      "headers": {}
    },
    "copilotkit": {
      "type": "remote",
      "url": "https://mcp.copilotkit.ai/sse",
      "enabled": true
    },
    "tavily-docs": {
      "type": "remote",
      "url": "https://docs.tavily.com/mcp",
      "enabled": true
    },
    "clerk": {
      "type": "remote",
      "url": "https://mcp.clerk.com/mcp",
      "enabled": true
    },
    "strands": {
      "type": "local",
      "command": ["uvx", "strands-agents-mcp-server"],
      "enabled": true
    }
  },
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"]
}
